# Site launch mode
# Keep true while Ghana Growers is pre-launch. Set false to restore public routes.
SITE_PRELAUNCH=true

# Stage 1 public intake controls (server-only, independently scoped, default OFF)
PUBLIC_INTAKE_FARMER_REGISTRATION_ENABLED=false
PUBLIC_INTAKE_SUPPLIER_REGISTRATION_ENABLED=false
PUBLIC_INTAKE_PRODUCT_LISTING_ENABLED=false
PUBLIC_INTAKE_BUYER_ENQUIRIES_ENABLED=false

# Admin access and pre-launch preview (server-only)
# Comma-separated approved administrator emails. Configure independently in Preview and Production.
ADMIN_EMAIL_ALLOWLIST=
# Random signing secret of at least 32 characters. Configure independently in Preview and Production.
PREVIEW_ACCESS_SECRET=

# Farmer registration: Google Sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_FARMER_SHEET_NAME="Farmer Registrations"
GOOGLE_SHEETS_BUYER_SHEET_NAME="Buyer Registrations"

# Farmer registration: admin email notifications via Resend
RESEND_API_KEY=
FARMER_REGISTRATION_FROM_EMAIL="Ghana Growers <onboarding@ghanagrowers.com>"
BUYER_REGISTRATION_FROM_EMAIL="Ghana Growers <onboarding@ghanagrowers.com>"

# Farm Help Assistant: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL="gpt-5.4-mini"
